# Coolify → your resource → Environment Variables. These are the ONLY values you
# set by hand; everything else is wired by docker-compose.yml. Mark the two secrets
# as "secret" in Coolify.

# --- secrets ---
ANTHROPIC_API_KEY=sk-ant-...           # Claude for intake + document draft
POSTGRES_PASSWORD=change-me-strong     # pgvector Postgres password

# --- public URLs (must match the domains you attach to the web/api services) ---
PUBLIC_WEB_URL=https://areeza.uz       # used for the API's CORS allowlist
PUBLIC_API_URL=https://api.areeza.uz   # baked into the web bundle at build time

# --- optional ---
# CLAUDE_MODEL=claude-sonnet-4-6        # interactive intake model (default if unset)
