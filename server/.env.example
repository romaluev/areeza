# Areeza Go backend configuration. Copy to server/.env and fill in the key.
# server/.env is gitignored.

# Required for the live intake conversation (Claude). Without it the server still
# boots (CRUD/classify/route/validate work) but the intake brain is disabled.
ANTHROPIC_API_KEY=

# Interactive intake model (CLAUDE.md: sonnet for intake, opus only for the final doc).
CLAUDE_MODEL=claude-sonnet-4-6

# On-device Python services (see services/classifier, services/rag). Optional —
# the backend degrades gracefully (keyword classifier / no RAG) when unset.
# Routing chain: tier1 → tier2 → Claude backup → keyword floor. CLASSIFIER_TIER2_URL
# (Qwen-LoRA, mac/MLX only) may be left blank to skip tier2.
CLASSIFIER_API_URL=http://localhost:8081
CLASSIFIER_TIER2_URL=http://localhost:8083
RAG_API_URL=http://localhost:8082

# PORT=8080
